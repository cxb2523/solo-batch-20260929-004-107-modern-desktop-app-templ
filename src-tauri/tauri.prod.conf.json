{
  "$schema": "./gen/schemas/desktop-schema.json",
  "identifier": "com.example.app",
  "app": {
    "windows": [
      {
        "label": "main",
        "devtools": false,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updates.example.com/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
